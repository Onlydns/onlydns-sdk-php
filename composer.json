{
    "name": "onlydns/onlydns-sdk",
    "description": "Official PHP SDK for OnlyDNS System API (onlydns.com)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OnlyDNS",
            "email": "support@onlydns.com"
        }
    ],
    "keywords": [
        "onlydns",
        "dns",
        "sdk",
        "php",
        "ai-agents",
        "networking"
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "OnlyDNS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OnlyDNS\\Tests\\": "tests/"
        }
    }
}
